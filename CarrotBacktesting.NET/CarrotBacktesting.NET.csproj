<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <DefaultItemExcludes>$(DefaultItemExcludes);V3\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Analysis\Exporters\Resources\echarts.min.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CarrotBackTesting.Net.UnitTest" />
    <InternalsVisibleTo Include="carrot-benchmark" />
    <InternalsVisibleTo Include="carrot-backtest" />
  </ItemGroup>

</Project>
